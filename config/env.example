# OpenCode Workflow Configuration
# Copy this file to `env` (no extension) and customize.
# `setup/client/*.sh` and `setup/client/windows.ps1` read this file.

# Hostname or IP of the Ollama server.
# - For LAN: the server's IP (e.g., 192.168.1.50)
# - For Tailscale: the server's Tailscale machine name (e.g., gpu-rig)
# - For same-machine setup: localhost
OLLAMA_HOST=gpu-rig

# Port Ollama is serving on. Default 11434.
OLLAMA_PORT=11434

# Model name as it appears in `ollama list`.
# Examples: qwen3-coder:30b, qwen2.5-coder:14b, deepseek-coder-v2:16b, codestral
OLLAMA_MODEL=qwen3-coder:30b

# Context window. Bigger = more memory use. 32K is a good default for agentic work.
# Don't exceed what your VRAM can handle (use `ollama ps` to check actual usage).
OLLAMA_CONTEXT_LENGTH=32768

# Keep model loaded in VRAM between requests (avoids slow cold-start).
# Format: <number><s|m|h>. Example: 60m, 2h, 24h.
OLLAMA_KEEP_ALIVE=60m

# CORS allowed origins for Ollama. "*" allows any client. Restrict if exposed publicly.
OLLAMA_ORIGINS=*
